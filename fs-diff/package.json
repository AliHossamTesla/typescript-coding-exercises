{
  "name": "fs-snapshot-diff",
  "version": "1.0.0",
  "description": "Compact Merkle-tree snapshots of a directory tree and a diff between two snapshots.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fsdiff": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run build && npm run test:coverage",
    "cli": "tsx src/cli.ts",
    "snapshot": "tsx src/cli.ts snapshot",
    "diff": "tsx src/cli.ts diff"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
